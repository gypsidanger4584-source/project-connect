<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 🔹 배경색 (화이트) -->
    <solid android:color="#FFFFFF" />

    <!-- 🔹 모서리 둥글게 -->
    <corners android:radius="16dp" />

    <!-- 🔹 약한 그림자 느낌을 위해 외곽선 -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

    <!-- 🔹 내부 여백 -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
