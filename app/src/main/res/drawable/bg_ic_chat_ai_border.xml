<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 아이콘과 테두리 사이의 안쪽 공간 = 흰색 -->
    <solid android:color="#FFFFFF" />

    <!-- 바깥쪽 파란 테두리 -->
    <stroke
        android:width="2dp"
        android:color="#1565C0" />

    <!-- 아이콘과 흰색 배경 사이 여백 -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />
</shape>
