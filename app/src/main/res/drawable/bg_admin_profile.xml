<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 안쪽 배경 (투명) -->
    <solid android:color="@android:color/transparent" />

    <!-- 테두리 색/두께 -->
    <stroke
        android:width="2dp"
        android:color="#F97316" /> <!-- 주황 느낌, 원하면 색 바꿔도 됨 -->

    <!-- 약간 여유 있게 -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

</shape>
