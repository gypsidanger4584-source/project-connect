<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 둥근 모서리 -->
    <corners android:radius="12dp" />

    <!-- 하얀 배경 -->
    <solid android:color="#FFFFFF" />

    <!-- 그림자 느낌을 살짝 주려면 -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

    <!-- 테두리 색 (선택사항) -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />
</shape>
