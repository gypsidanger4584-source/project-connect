<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup 규칙 (API 30 이하).
   로그인 정보가 담긴 SharedPreferences는 백업에서 제외한다.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="loginPrefs.xml"/>
    <exclude domain="sharedpref" path="auth_prefs.xml"/>
    <exclude domain="sharedpref" path="secure_login_prefs.xml"/>
</full-backup-content>
