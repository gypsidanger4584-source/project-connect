<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB"
    tools:context=".alogic.StudyBoardActivity">

    <!-- 📦 기존 내용 감싸는 LinearLayout -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 상단 영역 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_study_gradient"
            android:padding="10dp">

            <!-- 스터디룸 제목 / 부제목 -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="스터디룸"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="방에 입장해서 함께 공부하세요"
                    android:textSize="14sp"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- 삼선 메뉴 버튼 -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_menu"
                android:contentDescription="메뉴"
                app:tint="@android:color/white" />

            <!-- 코인 표시 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/btnMenu"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@android:color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvCoin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 이용 방법 박스 -->
            <LinearLayout
                android:id="@+id/tipBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_tip_box"
                android:padding="12dp"
                android:layout_marginTop="90dp"
                android:layout_below="@id/tvSubtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 스터디룸 이용 방법"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2D2D2D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 방에 입장해서 자유롭게 채팅하세요"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:textColor="#444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 문제를 만들고, 맞추시면 1점씩드립니다.."
                    android:textSize="13sp"
                    android:textColor="#444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 5점당 칭호 하나씩 드립니다.."
                    android:textSize="13sp"
                    android:textColor="#444" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 🔹 상단과 리스트 사이: 카테고리 스피너 바 -->
        <LinearLayout
            android:id="@+id/layoutFilterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvFilterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원하는 방을 골라보세요"
                android:textSize="13sp"
                android:textColor="#555555" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:entries="@array/study_category_filter" />
        </LinearLayout>

        <!-- 스터디룸 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerStudyRooms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp" />

        <!-- 하단 네비게이션 -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="8dp"
            android:gravity="center">

            <!-- 게시판 -->
            <LinearLayout
                android:id="@+id/nav_board"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icon_board"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_chat"
                    android:contentDescription="게시판" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="게시판"
                    android:textSize="13sp"
                    android:textColor="#0B325A"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 스터디게시판 -->
            <LinearLayout
                android:id="@+id/btnStudyBoard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_study"
                    android:contentDescription="스터디게시판" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="스터디"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 시간표 -->
            <LinearLayout
                android:id="@+id/btntimetable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_timetable"
                    android:contentDescription="시간표" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시간표"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ⭐️ 학식 랜덤 채팅 -->
            <LinearLayout
                android:id="@+id/nav_random_chat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/icon_random_chat"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_utensils_24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="랜덤매칭"
                    android:textSize="12sp"
                    android:textColor="#0B325A"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ✏️ FloatingActionButton (하단 오른쪽 고정, 네비게이션 위에 뜸) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="84dp"
        app:srcCompat="@drawable/ic_add"
        app:tint="@android:color/white"
        app:backgroundTint="#0B325A"
        app:elevation="8dp"
        app:useCompatPadding="true"
        app:fabSize="normal"
        style="@style/Widget.MaterialComponents.FloatingActionButton" />

</FrameLayout>
