<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMatching"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_orange_gradient"
    android:padding="16dp">

    <!-- 카드 컨테이너 -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="700dp"
        android:background="@drawable/bg_container_round"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 중앙 애니메이션 영역 -->
        <FrameLayout
            android:id="@+id/animArea"
            android:layout_width="256dp"
            android:layout_height="256dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp">

            <!-- 회전하는 바깥 원 -->
            <ImageView
                android:id="@+id/ivOuterRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ring_orange_200" />

            <!-- 가운데 펄스 -->
            <ImageView
                android:id="@+id/ivPulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="32dp"
                android:background="@drawable/circle_orange_pulse" />

            <!-- 중앙 spoon 아이콘 (2배 증가: 80dp → 160dp) -->
            <FrameLayout
                android:id="@+id/centerIconWrap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foregroundGravity="center">

                <ImageView
                    android:id="@+id/ivUtensils"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:src="@drawable/spoon"/>
            </FrameLayout>

            <!-- 떠다니는 아이콘 영역 크기 44dp → 88dp -->
            <!-- rice (왼쪽 위) -->
            <LinearLayout
                android:id="@+id/floatRice"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-16dp"
                android:layout_marginTop="-16dp"
                android:background="@drawable/circle_white_elevated"
                android:gravity="center">

                <!-- 아이콘 24dp → 48dp -->
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/rice"/>
            </LinearLayout>

            <!-- chicken (오른쪽 위) -->
            <LinearLayout
                android:id="@+id/floatChicken"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="-16dp"
                android:layout_marginTop="-16dp"
                android:background="@drawable/circle_white_elevated"
                android:gravity="center">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/chicken"/>
            </LinearLayout>

            <!-- coffee (아래 중앙) -->
            <LinearLayout
                android:id="@+id/floatCoffee"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-16dp"
                android:background="@drawable/circle_white_elevated"
                android:gravity="center">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:src="@drawable/coffee"/>
            </LinearLayout>

        </FrameLayout>

        <!-- 타이틀 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학식 메이트를 찾는 중..."
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="함께 밥 먹을 친구를 찾고 있어요"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- 타이머 pill -->
        <LinearLayout
            android:id="@+id/timerPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_timer_pill"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvTimerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="남은 시간"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2:00"
                android:textColor="#EA580C"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>

        <!-- 진행 바 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="0"
            android:max="120"
            android:progressDrawable="@drawable/progress_match_orange"
            android:layout_marginBottom="24dp"/>

        <!-- 취소 버튼 -->
        <LinearLayout
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_outline_round"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매칭 취소"
                android:textColor="#1F2937"
                android:textStyle="bold"
                android:textSize="15sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
