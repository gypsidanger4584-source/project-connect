<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"  android:id="@+id/memoItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/memo_background_rounded">

    <LinearLayout
        android:id="@+id/memoHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <View
            android:id="@+id/vColorChip"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/memo_color_chip_rect"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvLectureTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Mobile App Dev"/>

        <TextView
            android:id="@+id/tvMemoDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"  tools:text="작성일: 10/7 (월)"/>

        <ImageView
            android:id="@+id/ivImportantStarIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/baseline_star_24"
            app:tint="#FFC107"  android:layout_marginEnd="8dp" android:contentDescription="Important Memo Star"
            android:visibility="gone"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/tvDDayChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/dday_chip_rounded"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="0dp"
            tools:text="D-7"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"  android:layout_marginStart="18dp"
        android:gravity="bottom"> <TextView
        android:id="@+id/tvMemoText"
        android:layout_width="0dp"
        android:layout_weight="1"  android:layout_height="wrap_content"
        android:textColor="#EEEEEE"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="프로젝트 마감일이 다가옵니다! 잊지 마세요." />

        <TextView
            android:id="@+id/tvReadMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[더보기]"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"

            android:layout_marginEnd="20dp" android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>