<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studyDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🟣 메인 채팅 화면 -->
    <LinearLayout
        android:id="@+id/layoutMainChat"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F8FC"
        android:clickable="false"
        android:focusableInTouchMode="false">

        <!-- 🔹 상단 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_study_gradient"
            android:layout_marginTop="20dp"
            android:elevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/back" />

                <TextView
                    android:id="@+id/tvRoomTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/room_a"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_menu"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/menu" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRoomInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/room_info"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 🔹 탭 메뉴 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#EDE4FF"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_chat"
                android:textStyle="bold"
                android:textColor="#7A4FF7"
                android:textSize="15sp"
                android:background="@drawable/bg_tab_selected" />

            <TextView
                android:id="@+id/tabProblem"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_quiz"
                android:textColor="#444"
                android:textSize="15sp"
                android:background="@drawable/bg_tab_unselected" />
        </LinearLayout>

        <!-- 🔹 채팅 RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- 🔹 메시지 입력창 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="8dp">

            <EditText
                android:id="@+id/editMessage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="@string/hint_enter_message"
                android:textColor="#222"
                android:textColorHint="#AAA"
                android:textSize="14sp"
                android:background="@drawable/bg_edittext_rounded"
                android:paddingHorizontal="16dp"
                android:maxLines="3"
                android:inputType="textMultiLine" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp">

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_send"
                    android:background="@drawable/bg_send_button"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/send_message" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 🟣 오른쪽 Drawer -->
    <LinearLayout
        android:id="@+id/drawerParticipants"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_drawer_gradient"
        android:padding="16dp">

        <!-- 🟢 내 프로필 -->
        <LinearLayout
            android:id="@+id/layoutMyProfileSimple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_profile_card">

            <ImageView
                android:id="@+id/userProfile"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/default_profile"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="userID"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/userTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="입문자"
                    android:textSize="13sp"
                    android:textColor="#E6E1FF"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🟣 참가자 목록 -->
        <TextView
            android:id="@+id/tvActiveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/active_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvInactiveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/inactive_title"
            android:textColor="#DDDDDD"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerInactive"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never" />

        <Button
            android:id="@+id/btnLeaveRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/leave_room"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:backgroundTint="#7A4FF7"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- 🔴 방 삭제 버튼 (방장 전용) -->
        <Button
            android:id="@+id/btnDeleteRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_room"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:backgroundTint="#D32F2F"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
