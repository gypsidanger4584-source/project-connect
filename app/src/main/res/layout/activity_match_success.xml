<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMatchSuccess"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_orange_gradient"
    android:padding="16dp">

    <!-- 카드 컨테이너 -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="700dp"
        android:background="@drawable/bg_container_round"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 성공 애니메이션 영역 (글로우 + 체크서클 + 식기 + 스파클) -->
        <FrameLayout
            android:id="@+id/animArea"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp">

            <!-- 배경 글로우(블러 대용) -->
            <ImageView
                android:id="@+id/glow"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:alpha="0.6"
                android:src="@drawable/bg_soft_circle_orange"/>

            <!-- 체크 서클 -->
            <ImageView
                android:id="@+id/ivCheckCircle"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle_128"
                app:tint="#F97316"/>

            <!-- 중앙 식기 아이콘 -->
            <ImageView
                android:id="@+id/ivUtensils"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_utensils_48"
                app:tint="#FFFFFFFF"/>

            <!-- 스파클 8개 (원형 배치) -->
            <ImageView
                android:id="@+id/spark1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="0dp"
                android:translationY="-70dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>

            <ImageView
                android:id="@+id/spark2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="49dp"
                android:translationY="-49dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>

            <ImageView
                android:id="@+id/spark3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="70dp"
                android:translationY="0dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>

            <ImageView
                android:id="@+id/spark4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="49dp"
                android:translationY="49dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>

            <ImageView
                android:id="@+id/spark5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="0dp"
                android:translationY="70dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>

            <ImageView
                android:id="@+id/spark6"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="-49dp"
                android:translationY="49dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>

            <ImageView
                android:id="@+id/spark7"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="-70dp"
                android:translationY="0dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>

            <ImageView
                android:id="@+id/spark8"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:translationX="-49dp"
                android:translationY="-49dp"
                android:src="@drawable/ic_sparkle_20"
                app:tint="#F59E0B"
                android:alpha="0.0"/>
        </FrameLayout>

        <!-- 텍스트/파트너 박스 -->
        <LinearLayout
            android:id="@+id/textBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매칭 성공! 🎉"
                android:textColor="#1F2937"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="학식 메이트를 찾았어요"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/partnerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_timer_pill"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvPartnerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="함께 식사할 친구"
                    android:textColor="#6B7280"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvPartnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="김민수"
                    android:textColor="#EA580C"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 시작 버튼 -->
        <LinearLayout
            android:id="@+id/btnStartChat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_orange_gradient"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStartChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="대화 시작하기"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>