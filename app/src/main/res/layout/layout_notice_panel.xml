<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noticeRoot"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:clipToOutline="true"
    android:padding="0dp">

    <!-- 🔷 상단바 (공지사항 제목 + 닫기 버튼) -->
    <RelativeLayout
        android:id="@+id/noticeHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- 🔵 제목 전체 묶음: 중앙 고정 -->
        <LinearLayout
            android:id="@+id/noticeTitleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_centerInParent="true">

            <TextView
                android:id="@+id/tvNoticeMajor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="학과"
                android:textColor="#0B325A"
                android:textStyle="bold"
                android:textSize="17sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvNoticeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="공지사항"
                android:textColor="#0B325A"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 🔴 닫기 버튼: 오른쪽 정렬 -->
        <TextView
            android:id="@+id/btnCloseNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[닫기]"
            android:textColor="#7A4FF7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingHorizontal="6dp"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- 🔷 공지 리스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNoNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="공지사항이 없습니다."
            android:textColor="#999"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- ✅ 3개까지만 확장 후 내부 스크롤 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:overScrollMode="ifContentScrolls"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical" />
    </LinearLayout>
</LinearLayout>
