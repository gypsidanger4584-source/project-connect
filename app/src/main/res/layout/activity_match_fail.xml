<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMatchFail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_orange_gradient"
    android:padding="16dp">

    <!-- 카드 컨테이너 -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="700dp"
        android:background="@drawable/bg_container_round"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fail Animation 영역 -->
        <FrameLayout
            android:id="@+id/animArea"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp">

            <!-- 흐릿한 배경 원 -->
            <ImageView
                android:id="@+id/bgBlurCircle"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:alpha="0.35"
                android:src="@drawable/bg_soft_circle_gray" />

            <!-- FAIL 아이콘 (fail.png 적용됨) -->
            <ImageView
                android:id="@+id/ivFail"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:src="@drawable/fail" />
        </FrameLayout>

        <!-- 텍스트들 -->
        <LinearLayout
            android:id="@+id/texts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매칭 실패"
                android:textColor="#1F2937"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSub1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="학식 메이트를 찾지 못했어요"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSub2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다시 시도하거나 나중에 다시 시도해주세요"
                android:textColor="#6B7280"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 안내 박스 -->
        <LinearLayout
            android:id="@+id/infoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_orange_box"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 팁"
                android:textColor="#7C2D12"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 점심/저녁 시간대에 시도해보세요"
                    android:textColor="#7C2D12"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 잠시 후 다시 시도해보세요"
                    android:textColor="#7C2D12"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 버튼들 -->
        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 다시 매칭하기 -->
            <LinearLayout
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_orange_gradient"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_refresh_20"
                    app:tint="#FFFFFFFF"/>

                <TextView
                    android:id="@+id/tvRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다시 매칭하기"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
            </LinearLayout>

            <!-- 간격 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp"/>

            <!-- 나가기 -->
            <LinearLayout
                android:id="@+id/btnGoBack"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_outline_round"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGoBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="나가기"
                    android:textColor="#1F2937"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
