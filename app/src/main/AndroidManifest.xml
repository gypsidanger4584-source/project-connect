<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/mainlogo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/mainlogo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Login_new"
        tools:targetApi="31">

        <activity
            android:name=".alogic.RegisterActivity"
            android:exported="true" />

        <activity
            android:name=".alogic.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alogic.MainActivity"
            android:exported="false" />

        <activity
            android:name=".alogic.TimetableActivity"
            android:exported="false" />

        <activity
            android:name=".alogic.PostDetailActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".alogic.WriteActivity"
            android:exported="true" />

        <activity
            android:name=".alogic.CategorySettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="login-new-a3576.web.app" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alogic.CampusMap"
            android:exported="true" />

        <activity
            android:name=".alogic.DetailActivity"
            android:exported="true" />

        <activity
            android:name=".alogic.BuildingDetail"
            android:exported="true" />

        <activity
            android:name=".login.MyPage"
            android:exported="true" />

        <activity
            android:name=".login.EditPostActivity" />

        <activity
            android:name=".alogic.FindAccountActivity"
            android:exported="true" />

        <activity
            android:name="com.example.login_new.alogic.StudyBoardActivity" />

        <activity
            android:name=".alogic.StudyChatActivity" />

        <activity
            android:name=".alogic.StudyRoomCreateActivity"
            android:exported="false" />

        <activity
            android:name=".alogic.StudyProblemActivity" />

        <activity
            android:name=".alogic.StudyProblemCreateActivity" />

        <activity
            android:name=".alogic.StudyProblemSolveActivity"
            android:exported="false" />

        <activity
            android:name=".alogic.TitleChangeActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- ⭐ 학식 랜덤 매칭 액티비티 -->
        <activity
            android:name=".alogic.RandomMatchActivity"
            android:exported="false" />

        <activity
            android:name=".alogic.MatchFailActivity" />

        <!-- ⭐ 실제 채팅방 액티비티 -->
        <activity
            android:name=".alogic.ChatRoomActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- ⭐ 추가: ChatActivity (1번 manifest에서 가져옴) -->
        <activity
            android:name="com.example.login_new.alogic.ChatActivity" />

    </application>

</manifest>
